{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UMM_RL formal run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "run_kind",
    "source_revision",
    "execution_revision",
    "dirty",
    "config_sha256",
    "environment",
    "status",
    "result_files",
    "artifacts",
    "retry"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "run_kind": {"enum": ["diagnostic", "formal"]},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"type": "boolean"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "status": {"enum": ["pass", "fail", "blocked"]},
    "result_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "canonical_uri", "sha256", "bytes"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "canonical_uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "retry": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["parent_run_id", "failure_reason"],
          "properties": {
            "parent_run_id": {"type": "string", "minLength": 1},
            "failure_reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": true
}

